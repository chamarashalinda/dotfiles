# ~/.zshrc — managed by chezmoi (dot_zshrc.tmpl)

# --- Powerlevel10k instant prompt (must stay at top) ---
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Homebrew (must run before oh-my-zsh so compinit sees brew completions) ---
{{- if eq .chezmoi.os "darwin" }}
# Apple Silicon Homebrew
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  # Newer `brew shellenv` runs `export FPATH`. An exported FPATH replaces the
  # built-in fpath of every child zsh, so a list missing zsh's core functions
  # dir breaks compinit, add-zsh-hook, etc. Keep fpath local to this shell.
  typeset +x FPATH
fi
{{- end }}

# --- Shared Homebrew (owned by another, e.g. admin, user) ---
# Running as a non-admin user while Homebrew belongs to an admin account is a
# valid setup, but compaudit flags every Homebrew fpath dir as "insecure" and
# oh-my-zsh's `compinit -i` strips them — including zsh's own core functions
# dir when zsh is Homebrew's — so compinit/add-zsh-hook/is-at-least vanish.
# Trusting those dirs grants this user no new access (it already runs that
# account's binaries), so enable ZSH_DISABLE_COMPFIX in exactly that case.
# Never when Homebrew is root-owned (already trusted) or world-writable
# (genuinely unsafe). An explicit ZSH_DISABLE_COMPFIX setting always wins.
if [[ -z "${ZSH_DISABLE_COMPFIX:-}" && -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX" && ! -O "$HOMEBREW_PREFIX" ]]; then
  () {
    zmodload -F zsh/stat b:zstat 2>/dev/null || return
    local d
    local -A st
    for d in "$HOMEBREW_PREFIX" "$HOMEBREW_PREFIX/share"; do
      zstat -H st -- "$d" 2>/dev/null || return
      (( st[uid] != 0 ))         || return  # root-owned: compaudit accepts it
      (( !(st[mode] & 8#002) ))  || return  # world-writable: keep the check
    done
    ZSH_DISABLE_COMPFIX=true
  }
fi

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  kubectl
  terraform
  docker
  aws
  helm
  sudo
  colored-man-pages
  history
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
  zsh-history-substring-search
)

source "$ZSH/oh-my-zsh.sh"

# --- Modular config files ---
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.exports" ]] && source "$HOME/.exports"

# --- Tool hooks (guarded — only if installed) ---
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]             && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ]    && source "$NVM_DIR/bash_completion"
# macOS Homebrew nvm path
[ -s "$(brew --prefix 2>/dev/null)/opt/nvm/nvm.sh" ] && source "$(brew --prefix)/opt/nvm/nvm.sh"

[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

if [[ -d "$HOME/.pyenv" ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
  command -v pyenv-virtualenv-init &>/dev/null && eval "$(pyenv virtualenv-init -)"
fi

# Go
[[ -d "$HOME/go/bin" ]] && export PATH="$HOME/go/bin:$PATH"

# Local bin
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# --- fzf ---
[[ -f "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"

# --- kubectl & kubectx completions ---
if command -v kubectl &>/dev/null; then
  source <(kubectl completion zsh)
fi

# --- Powerlevel10k config ---
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
