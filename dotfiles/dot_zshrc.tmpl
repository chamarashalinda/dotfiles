# ~/.zshrc — managed by chezmoi (dot_zshrc.tmpl)

# --- Powerlevel10k instant prompt (must stay at top) ---
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# --- Homebrew (before oh-my-zsh, so compinit picks up brew completions) ---
{{- if eq .chezmoi.os "darwin" }}
if [[ -f /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
  # brew shellenv exports FPATH; child shells would inherit it in place of
  # their default fpath.
  typeset +x FPATH
fi
{{- end }}

# --- Homebrew owned by another user ---
# compaudit treats dirs owned by another non-root user as insecure, and
# `compinit -i` drops them from fpath. With Homebrew's zsh that includes the
# core functions dir (compinit, add-zsh-hook, ...). Skip the audit in that
# case, unless the prefix is world-writable or ZSH_DISABLE_COMPFIX is set.
if [[ -z "${ZSH_DISABLE_COMPFIX:-}" && -n "${HOMEBREW_PREFIX:-}" && -d "$HOMEBREW_PREFIX" && ! -O "$HOMEBREW_PREFIX" ]]; then
  () {
    zmodload -F zsh/stat b:zstat 2>/dev/null || return
    local d
    local -A st
    for d in "$HOMEBREW_PREFIX" "$HOMEBREW_PREFIX/share"; do
      zstat -H st -- "$d" 2>/dev/null || return
      (( st[uid] != 0 ))         || return  # root-owned
      (( !(st[mode] & 8#002) ))  || return  # world-writable
    done
    ZSH_DISABLE_COMPFIX=true
  }
fi

# --- oh-my-zsh ---
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"

plugins=(
  git
  kubectl
  terraform
  docker
  aws
  helm
  sudo
  colored-man-pages
  history
  zsh-autosuggestions
  zsh-syntax-highlighting
  zsh-completions
  zsh-history-substring-search
)

source "$ZSH/oh-my-zsh.sh"

# --- Modular config files ---
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.exports" ]] && source "$HOME/.exports"

# --- Tool hooks (guarded — only if installed) ---
command -v zoxide &>/dev/null && eval "$(zoxide init zsh)"
command -v direnv &>/dev/null && eval "$(direnv hook zsh)"

# nvm
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ]             && source "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ]    && source "$NVM_DIR/bash_completion"
# macOS Homebrew nvm path
[ -s "$(brew --prefix 2>/dev/null)/opt/nvm/nvm.sh" ] && source "$(brew --prefix)/opt/nvm/nvm.sh"

[[ -f "$HOME/.cargo/env" ]] && source "$HOME/.cargo/env"

if [[ -d "$HOME/.pyenv" ]]; then
  export PYENV_ROOT="$HOME/.pyenv"
  export PATH="$PYENV_ROOT/bin:$PATH"
  eval "$(pyenv init -)"
  command -v pyenv-virtualenv-init &>/dev/null && eval "$(pyenv virtualenv-init -)"
fi

# Go
[[ -d "$HOME/go/bin" ]] && export PATH="$HOME/go/bin:$PATH"

# Local bin
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# --- fzf ---
[[ -f "$HOME/.fzf.zsh" ]] && source "$HOME/.fzf.zsh"

# --- kubectl & kubectx completions ---
if command -v kubectl &>/dev/null; then
  source <(kubectl completion zsh)
fi

# --- Powerlevel10k config ---
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
